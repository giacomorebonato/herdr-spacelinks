#!/usr/bin/env bun
'use strict';

// gh shim — transparent passthrough that tells herdr-spacelinks the moment a
// PR is created, so the PR link lands in the Space's sidebar instantly.
// Opt-in: see README "PR links" for install and removal. Never changes gh
// behavior: every invocation runs the real gh, and the notify path is fully
// silent on failure.

import { spawnSync } from 'node:child_process';
import * as fs from 'node:fs';
import * as net from 'node:net';
import * as path from 'node:path';

export function isPrCreate(argv: string[]): boolean {
  return argv[0] === 'pr' && argv[1] === 'create';
}

/** First `gh` on PATH outside the shim's own directory — null if none. */
export function realGhPath(pathEnv: string, selfPath: string): string | null {
  const selfDir = path.dirname(path.resolve(selfPath));
  for (const dir of (pathEnv || '').split(path.delimiter)) {
    if (!dir) continue;
    const candidate = path.join(path.resolve(dir), 'gh');
    if (path.dirname(candidate) === selfDir) continue;
    if (fs.existsSync(candidate)) return candidate;
  }
  return null;
}

/** Ask herdr to run the spacelinks sync action for this pane's workspace. */
export function notifySpacelinks(socketPath: string, workspaceId: string): Promise<boolean> {
  return new Promise((resolve) => {
    let settled = false;
    let reqId = '';
    const socket = net.createConnection(socketPath);
    const done = (ok: boolean): void => {
      if (settled) return;
      settled = true;
      socket.destroy();
      resolve(ok);
    };
    socket.setTimeout(2000);
    socket.on('error', () => done(false));
    socket.on('timeout', () => done(false));
    socket.on('close', () => done(false));
    socket.on('connect', () => {
      reqId = `spacelinks-shim-${Date.now()}`;
      socket.write(`${JSON.stringify({
        id: reqId,
        method: 'plugin.action.invoke',
        params: {
          action_id: 'spacelinks.sync',
          context: { workspace_id: workspaceId },
        },
      })}\n`);
    });
    socket.on('data', (buf: Buffer) => {
      const line = buf.toString().split('\n').find((l) => l.trim());
      if (!line) return;
      try {
        const parsed: unknown = JSON.parse(line);
        if (isRecord(parsed) && parsed['id'] === reqId) {
          done(isRecord(parsed['result']));
        }
      } catch {
        done(false);
      }
    });
  });
}

function isRecord(value: unknown): value is Record<string, unknown> {
  return typeof value === 'object' && value !== null && !Array.isArray(value);
}

/** URL of the current branch's PR right after a successful create — null if none. */
function prUrlJustCreated(realGh: string): string | null {
  const res = spawnSync(realGh, ['pr', 'view', '--json', 'url'], { encoding: 'utf8' });
  if (res.status !== 0) return null;
  try {
    const parsed: unknown = JSON.parse(res.stdout);
    if (isRecord(parsed) && typeof parsed['url'] === 'string' && parsed['url']) {
      return parsed['url'];
    }
  } catch { /* not JSON */ }
  return null;
}

async function main(): Promise<void> {
  const args = process.argv.slice(2);
  const real = realGhPath(process.env['PATH'] || '', process.argv[1] || '');
  if (!real) {
    process.stderr.write('spacelinks gh shim: real gh not found on PATH\n');
    process.exit(127);
  }
  const run = spawnSync(real, args, { stdio: 'inherit' });
  const status = run.status ?? 1;
  if (
    status === 0
    && isPrCreate(args)
    && process.env['HERDR_SOCKET_PATH']
    && process.env['HERDR_WORKSPACE_ID']
  ) {
    if (prUrlJustCreated(real)) {
      try {
        await notifySpacelinks(
          process.env['HERDR_SOCKET_PATH'] || '',
          process.env['HERDR_WORKSPACE_ID'] || '',
        );
      } catch { /* never break the user's gh */ }
    }
  }
  process.exit(status);
}

if (require.main === module) {
  main().catch((err: unknown) => {
    process.stderr.write(`spacelinks gh shim: ${err instanceof Error ? err.message : String(err)}\n`);
    process.exit(1);
  });
}
